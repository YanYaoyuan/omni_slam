<?xml version="1.0"?>
<package format="3">
  <name>omni_slam_manager</name>
  <version>0.1.0</version>
  <description>Process supervision and versioned map assets for omni_slam.</description>
  <maintainer email="yan@example.com">Omni maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>omni_robot_interfaces</exec_depend>
  <exec_depend>omni_slam_interfaces</exec_depend>
  <exec_depend>omni_tf_manager</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
